sets/published-data/4b7027bb89d7e7c1b379b968.webp","assets/published-data/1d610e2368daea2b5533fe0b.webp","assets/published-data/b17360f8024bcaba354eb8c1.webp","assets/published-data/c7d23864f382341cd73a38e1.webp","assets/published-data/0e5ac7003801aefc4303ae73.webp","assets/published-data/4df5eb010cd3e6b8d8c37903.webp","assets/published-data/a6c91ffcb00eae77c72d5472.webp","assets/published-data/c420732541783066aed7c746.webp","assets/published-data/dc6be7c44c55d5d6e9471a8f.webp","assets/published-data/67469f6db86a22dd1c7ca601.webp"]],"geneTextByKey":{"gene-index":{"html":"02 / GENE","style":"font-family: \"NTX Big Caslon\", \"Times New Roman\", serif; text-transform: none;"},"gene-culture":{"html":"CHINESE CULTURE &amp; INTANGIBLE HERITAGE","style":"font-family: \"NTX Big Caslon\", \"Times New Roman\", serif; text-transform: none;"},"gene-contemporary":{"html":"CONTEMPORARY ART &amp; DESIGN","style":"font-family: \"NTX Big Caslon\", \"Times New Roman\", serif; text-transform: none;"}},"noticeText":{"zh":{"html":"点击可中英文转换","style":"font-family: \"NTX Source Han\", \"Songti SC\", serif;"},"en":{"html":"CLICK TO SWITCH LANGUAGE","style":"font-family: \"NTX Big Caslon\", \"Times New Roman\", serif;"}},"noticeFonts":{"zh":"sourcehan","en":"bigcaslon"},"footerContact":{"xiaohongshu":"#","weixin":"#","email":"studio@example.com"},"articleCatalog":{"objects":{"category":"nomadic","subcategory":"spiritual","title":["The container of high feet, the soul of nomadic, integrated into the light of the city","高足之器，\n承游牧之魂，\n融于城市之光"],"categoryLabel":["NOMADIC SERIES","游牧系列"],"type":["ESSAY 001","文章 001"],"date":"31.08.26","read":"6 MIN READ","images":["assets/published-data/65915db832b3622338fa61cc.webp","assets/published-data/ab5d4202803a92bde60065f2.webp","assets/published-data/143e5d75f414756e4762dce3.webp"],"dek":["- Are you nomad in the city?\n\t\n\"Nomad Series Nomadic\" Series\" is a ceramic ware that combines the art design and humanistic spirit of the mud swallowing elephant, born under the thinking of cultural heritage and contemporary lifestyle. The new series and its culture - take the form of traditional and high foot, inherit the spirit of modern nomads, carry the continuation of emotion and memory, and travel the boundary between daily and art.\n\t\nIn the history of ceramics and utensils culture, the most popular utensils in the Yuan Dynasty were the most popular nomads in the Yuan Dynasty. Today's people have embarked on their own road of urban nomadic - inheriting the blood of nomadic, walking through the modern city, and the utensils carrying emotions and memories are becoming people's new spiritual partners.\nMud Tun Elephant conducted experiments and innovations on this: continues the nomadic spirit condensed in the high-footed utensils, and creates a free walk between practicality and art. Replacement containers can not only accompany people's various daily needs, but also decorate the living space and become a ritual and charging station that belongs to oneself.\n\t\nThe \"Nomadic Series Nomadic Series\" expects: to accompany people's lives in more diverse and longer-term lives, by incorporating nested structures into the design of ceramic containers - \"dividing into containers, together as sculpture\".\nMud swallow will continue to design and create more different categories of ceramic containers for free matching and use, which includes the thinking and manifestation of the \"connection\" of modern urban life:\n\t\nNomads with people,\nlife and art flow together,\nPeople and all things are connected.\n\t","——你是否正在城市里游牧？\n\t\n“游牧系列 NOMADIC series”是泥吞象结合艺术设计与人文精神，在对文化传承与当代生活方式的思考之下诞生的陶瓷器物新系列及其文化——取传统高足的形态，承现代游牧的精神，载情感与记忆的延续，游日常与艺术的边界。\n\t\n在陶瓷器物文化的历史中，高足器于元代最受欢迎，原因是元代多游牧民族，高足器最适宜游牧生活携带与日常使用。而今天的人们，踏上了属于自己的城市游牧之路——继承游牧的血脉，穿行于现代城市中，携带着情感与记忆的器物正成为人们新的精神伙伴。\n泥吞象对此进行了实验与创新：延续凝结于高足器中的游牧精神，创作在实用与艺术之间自由游走的现代容器，不仅能陪伴人们的各种日常需求，也能装点生活空间，成为一种独属于自我的仪式感与充电站。\n\t\n“游牧系列 NOMADIC series”期待：更多样、更长久地陪伴人们的生活，通过将嵌套式结构融入到陶瓷容器设计中——“分则为容器，合则为雕塑”。\n泥吞象将持续设计与创作更多不同品类的陶瓷容器以供自由搭配和使用，这其中包含着对现代城市生活“联结”的思考与显化：\n\t\n器物与人共游牧，\n生活与艺术共流动，\n人与万物共联结。\n\t"],"tags":[["Objects","器物"],["Culture","文化"],["Essay","文章"]]},"material":{"category":"freedom","subcategory":"","title":["THE MEMORY OF MATERIAL","材料的记忆"],"categoryLabel":["FREEDOM WITH WISDOM","自由明智"],"type":["PROCESS 002","过程 002"],"date":"18.08.26","read":"5 MIN READ","images":["assets/catalog/product-10.webp","assets/catalog/product-9.webp","assets/catalog/product-8.webp"],"dek":["A study of how pressure, heat and time remain present in the finished form.","关于压力、温度与时间如何留存在最终形态之中的研究。"],"tags":[["Material","材料"],["Process","过程"]]},"slowly":{"category":"nitunxiang","subcategory":"","title":["WHY WE MAKE SLOWLY","缓慢制作的理由"],"categoryLabel":["NITUNXIANG","泥吞象"],"type":["STUDIO 003","工作室 003"],"date":"02.07.26","read":"7 MIN READ","images":["assets/catalog/product-11.webp","assets/catalog/product-12.webp","assets/catalog/product-13.webp"],"dek":["Each article can retain its own date, category and cover. Generous space and an editorial rhythm keep the page from feeling like a conventional blog list.","不同文章可以保留各自的发布日期、类别和封面。页面采用留白与大字号节奏，避免传统博客的资讯列表感。"],"tags":[["Studio","工作室"],["Craft","手工艺"]]}},"articleText":{},"bilingualCases":{"hero-kicker":"upper","hero-index":"preserve","hero-collection":"upper","hero-scroll":"preserve","manifesto-index":"preserve","manifesto-title":"preserve","manifesto-copy":"preserve","manifesto-side":"preserve","gene-index":"preserve","gene-culture":"preserve","gene-contemporary":"preserve","glaze-1-entry":"preserve","glaze-2-entry":"preserve","glaze-3-entry":"preserve","works-index":"preserve","works-title":"preserve","works-copy":"preserve","works-link":"preserve","about-index":"preserve","about-title":"title","about-copy":"preserve","journal-index":"preserve","journal-title-1":"preserve","journal-title-2":"preserve","footer-top-link":"preserve","object-meta-0":"preserve","object-meta-1":"preserve","object-meta-2":"preserve","object-meta-3":"pre